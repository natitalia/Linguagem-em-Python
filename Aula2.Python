    {
      "cell_type": "code",
      "source": [
        "#exemplo de if com elif e else\n",
        "idade = 61\n",
        "if idade < 18:\n",
        "  print(\"Jovem!\")\n",
        "elif idade >= 18 and idade <= 60:\n",
        "  print(\"adulto!\")\n",
        "else:\n",
        "  print(\"Idoso\")"
      ],
