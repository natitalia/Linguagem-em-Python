      "source": [
        "#operadores lógicos\n",
        "numero1 = 1\n",
        "numero2 = 2\n",
        "\n",
        "# exemplo de if com operador lógico AND\n",
        "if numero1 == 1 and numero2 == 2:\n",
        "  print(\"Os valores são iguais!\")"
      ]
    },
