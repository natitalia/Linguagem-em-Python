      "source": [
        "# estruturas de repetição\n",
        "# Exemplo simples de while\n",
        "contador = 0\n",
        "\n",
        "while(contador < 10):\n",
        "  print(contador)\n",
        "\n",
        "  # vamos forçar a parada\n",
        "  if contador == 4:\n",
        "    break\n",
        "\n",
        "  contador += 1"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1Gbk8NVQaU8U",
        "outputId": "4dedf933-9c02-4d00-8459-ce59eeafb762"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0\n",
            "1\n",
            "2\n",
            "3\n",
            "4\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# exemplo de repetição com continue\n",
        "# pular uma execução\n",
        "contador = 0\n",
        "\n",
        "while (contador < 10):\n",
        "  contador += 1\n",
        "\n",
        "# pular a interação\n",
        "  if contador == 2:\n",
        "    continue\n",
        "\n",
        "  print(contador)\n"
      ],
