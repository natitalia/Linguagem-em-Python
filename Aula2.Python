    {
      "cell_type": "code",
      "source": [
        "# exemplo match/case\n",
        "opcao = int(input(\"Informe a opção: \"))\n",
        "match opcao:\n",
        "  case 1:\n",
        "    print(\"Falar com atendente\")\n",
        "  case 2:\n",
        "    print(\"Dúvidas frequentes\")\n",
        "  case _:\n",
        "    print(\"Opção inválida\")"
      ],
