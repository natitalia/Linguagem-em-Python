      "source": [
        "# exemplo de junção de lista\n",
        "lista1 = [1,2,3]\n",
        "lista2 = [4,5,6]\n",
        "lista3 = [7]\n",
        "\n",
        "lista_final = lista1 + lista2 + lista3\n",
        "print(lista_final)\n",
        "\n",
        "lista1.extend(lista2)\n",
        "lista1.extend(lista3)\n",
        "print(lista1)\n",
        "\n",
        "\n",
        "print(lista1.count(2)) # contagem de itens por valor"
      ],
